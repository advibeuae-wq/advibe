RewriteEngine On

# Canonicalize /index.html to / with a permanent redirect (SEO: avoid
# duplicate-content between the two URLs for the homepage). Pattern is
# anchored to the root-level file only, so /blog/index.html is untouched.
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
